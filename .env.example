# Docker Compose settings — copy to .env

# Signs session cookies. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Interface the ports are published on. Use 0.0.0.0 to expose them on all interfaces.
BIND_ADDRESS=127.0.0.1
E2E_HUB_PORT=9877
VNC_PORT=6080

# Public URL of the Live View gateway (port 6080) when it sits behind a reverse proxy,
# e.g. https://qa-stream.example.com. Empty: http://<e2e-hub-host>:VNC_PORT
VNC_PUBLIC_BASE_URL=

# Number of reverse proxies in front of the E2E Hub (for client IPs / HTTPS detection).
TRUST_PROXY=0

MAX_CONCURRENT_RUNS_PER_USER=10
